public static class EconomyLogger
{
    private static readonly object _lock = new object();
    public static string SessionFile => _sessionFile;
    private static string _sessionFile;
    private static string _sessionId;
    public static string InitError { get; private set; }

    static EconomyLogger()
    {
        try {
            _sessionId = Guid.NewGuid().ToString("N").Substring(0, 8);
            if (!Directory.Exists(EconomyConfig.LOG_DIR)) Directory.CreateDirectory(EconomyConfig.LOG_DIR);
            _sessionFile = Path.Combine(EconomyConfig.LOG_DIR, $"economy_session_{DateTime.Now:yyyyMMdd_HHmmss}_{_sessionId}.log");
            File.WriteAllText(_sessionFile, $"SYSTEM: Logger started.\n");
        } catch (Exception ex) { InitError = ex.Message; }
    }

    public static void Info(string comp, string msg, string tid) => Log("INFO", comp, msg, tid);
    public static void Error(string comp, string msg, Exception ex, string tid) => Log("ERROR", comp, $"{msg}: {ex?.Message}", tid);
    public static void Fatal(string comp, string msg, Exception ex, string tid) => Log("FATAL", comp, $"{msg}: {ex?.Message}", tid);

    private static void Log(string level, string comp, string msg, string tid)
    {
        lock(_lock) {
            try { File.AppendAllText(_sessionFile, $"[{DateTime.Now:HH:mm:ss}] [{level}] [{comp}] [{tid}] {msg}\n"); } catch {}
        }
    }
}

